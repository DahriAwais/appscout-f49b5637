{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "types": ["node"],
    "paths": {
      "@/*": ["./apps/mobile/*"],
      "@/assets/*": ["./apps/mobile/assets/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "apps/mobile/**/*.ts",
    "apps/mobile/**/*.tsx",
    "app.config.ts",
    "global.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "uniwind-types.d.ts"
  ],
  "exclude": ["node_modules", "context"]
}
