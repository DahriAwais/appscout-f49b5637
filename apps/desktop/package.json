{
  "name": "@appscout/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/copy-icon.mjs && vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/model.test.ts",
    "package:release": "npm run build && electron-builder --win nsis --config electron-builder.release.json --publish never",
    "package:win": "npm run build && electron-builder --win nsis --config electron-builder.json",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@appscout/core": "1.0.0",
    "@tanstack/react-virtual": "^3.13.0",
    "better-sqlite3": "^12.0.0",
    "electron-updater": "^6.6.0",
    "framer-motion": "^12.0.0",
    "google-play-scraper": "^10.0.0",
    "lucide-react": "^0.562.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "40.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "vite": "^7.0.0"
  }
}
